{
  "name": "boussole-2027",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Boussole 2027 — outil de réflexion politique (100 questions, 14 axes), calcul 100 % côté navigateur.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "extract:candidates": "tsx scripts/extract-candidates.ts",
    "extract:thinkers": "tsx scripts/extract-thinkers.ts",
    "lint:questions": "tsx scripts/lint-questions.ts",
    "simulate:neutrality": "tsx scripts/simulate-neutrality.ts",
    "simulate:personas": "tsx scripts/simulate-personas.ts",
    "audit:questions": "tsx scripts/generate-audit.ts",
    "psychometrics": "tsx scripts/psychometrics.ts"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
